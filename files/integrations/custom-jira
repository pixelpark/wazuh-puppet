#!/var/ossec/framework/python/bin/python3
# Wazuh -> Jira integration (Wazuh alarm routing, SPKSUP-6798 / ADR 0002).
#
# Invoked by wazuh-integratord for alerts matching the custom-jira
# <integration> block (rule-ID allowlist). Creates a Jira issue for the alert
# unless an open issue with the same dedup label exists (JQL search -> skip).
#
# argv (Wazuh 4.x integratord convention, matching the official integrations):
#   1: path to the file holding the triggering alert (JSON, alert_format json)
#   2: <api_key>  -- "user:secret" for basic auth, or a personal access token
#                    (no colon) sent as "Authorization: Bearer"
#   3: <hook_url> -- Jira base URL, e.g. https://jira.example.com
#   4+: optional 'debug' flag and/or the <options> JSON file (integratord
#       passes a temp path ending in 'options'). 'dry-run' builds the payload
#       and logs it without calling Jira (for smoke tests).
#
# <options> JSON keys:
#   project     (required) Jira project key, e.g. "SPKSUP"
#   issue_type  issue type name                        (default "Task")
#   labels      extra labels, list of strings          (default [])
#   dedup       search for an open issue before create (default true)
#   verify_tls  verify the Jira TLS certificate        (default true)
#   timeout     HTTP timeout in seconds                (default 30)

import json
import sys
from datetime import datetime, timezone

import requests

LOG_FILE = '/var/ossec/logs/integrations.log'
MAX_LOG_EXCERPT = 2000
MAX_SUMMARY = 255

DEBUG = False
DRY_RUN = False


def log(message):
    line = '{} custom-jira: {}'.format(datetime.now(timezone.utc).isoformat(), message)
    try:
        with open(LOG_FILE, 'a') as handle:
            handle.write(line + '\n')
    except OSError:
        pass
    if DEBUG:
        print(line)


def parse_args(argv):
    if len(argv) < 4:
        raise SystemExit('usage: custom-jira <alert_file> <api_key> <hook_url> [debug] [options_file]')
    alert_file, api_key, hook_url = argv[1], argv[2], argv[3]
    api_key = api_key.strip().strip('"\'')
    options = {}
    for arg in argv[4:]:
        if arg.endswith('options'):
            try:
                with open(arg) as handle:
                    options = json.load(handle)
            except (OSError, ValueError) as err:
                log('WARNING could not read options file {}: {}'.format(arg, err))
    return alert_file, api_key, hook_url.rstrip('/'), options


def auth_kwargs(api_key, options):
    kwargs = {
        'timeout': int(options.get('timeout', 30)),
        'verify': bool(options.get('verify_tls', True)),
        'headers': {'Content-Type': 'application/json'},
    }
    if ':' in api_key:
        user, secret = api_key.split(':', 1)
        kwargs['auth'] = (user, secret)
    else:
        kwargs['headers']['Authorization'] = 'Bearer {}'.format(api_key)
    return kwargs


def build_payload(alert, options, dedup_label):
    rule = alert.get('rule', {})
    agent = alert.get('agent', {})
    summary = 'Wazuh alarm rule {} (level {}): {} @ {}'.format(
        rule.get('id', '?'), rule.get('level', '?'),
        rule.get('description', 'no description'), agent.get('name', 'unknown agent'),
    )[:MAX_SUMMARY]
    description = '\n'.join([
        'h3. Wazuh Security Alarm',
        '||field||value||',
        '|Rule|{} — {}|'.format(rule.get('id', '?'), rule.get('description', '')),
        '|Level|{}|'.format(rule.get('level', '?')),
        '|Groups|{}|'.format(', '.join(rule.get('groups', []))),
        '|Agent|{} {} ({})|'.format(agent.get('id', '?'), agent.get('name', '?'), agent.get('ip', '?')),
        '|Timestamp|{}|'.format(alert.get('timestamp', '?')),
        '|Location|{}|'.format(alert.get('location', '?')),
        '',
        '{noformat}',
        str(alert.get('full_log', ''))[:MAX_LOG_EXCERPT],
        '{noformat}',
    ])
    return {
        'fields': {
            'project': {'key': options['project']},
            'issuetype': {'name': options.get('issue_type', 'Task')},
            'summary': summary,
            'description': description,
            'labels': [dedup_label] + list(options.get('labels', [])),
        },
    }


def open_issue_exists(base_url, kwargs, project, dedup_label):
    jql = 'project = "{}" AND labels = "{}" AND statusCategory != Done'.format(project, dedup_label)
    response = requests.post(
        '{}/rest/api/2/search'.format(base_url),
        json={'jql': jql, 'maxResults': 1, 'fields': ['key']},
        **kwargs,
    )
    response.raise_for_status()
    result = response.json()
    if result.get('total', 0) > 0:
        return result['issues'][0]['key']
    return None


def main(argv):
    global DEBUG, DRY_RUN
    DEBUG = 'debug' in argv[4:]
    DRY_RUN = 'dry-run' in argv[4:]

    alert_file, api_key, hook_url, options = parse_args(argv)
    if 'project' not in options:
        log('ERROR <options> must define "project"')
        return 1

    with open(alert_file) as handle:
        alert = json.load(handle)
    rule_id = alert.get('rule', {}).get('id', '0')
    agent_id = alert.get('agent', {}).get('id', '000')
    dedup_label = 'wazuh-r{}-a{}'.format(rule_id, agent_id)

    kwargs = auth_kwargs(api_key, options)
    payload = build_payload(alert, options, dedup_label)

    if DRY_RUN:
        log('dry-run payload: {}'.format(json.dumps(payload)))
        return 0

    try:
        if options.get('dedup', True):
            existing = open_issue_exists(hook_url, kwargs, options['project'], dedup_label)
            if existing:
                log('skip rule {} agent {}: open issue {} already exists'.format(rule_id, agent_id, existing))
                return 0
        response = requests.post('{}/rest/api/2/issue'.format(hook_url), json=payload, **kwargs)
        response.raise_for_status()
        log('created {} for rule {} agent {}'.format(response.json().get('key', '?'), rule_id, agent_id))
        return 0
    except requests.exceptions.RequestException as err:
        log('ERROR Jira request failed for rule {} agent {}: {}'.format(rule_id, agent_id, err))
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
